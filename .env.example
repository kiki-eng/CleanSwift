# CleanSwift environment variables
#
# The app reads its runtime configuration from src/config/env.ts, which keys
# off __DEV__ (Metro debug vs release build). If you introduce
# react-native-config or a similar tool, these are the variables to provide.
# NEVER commit real secrets to this file.

# Backend REST API root, including the /api/v1 prefix.
API_BASE_URL=https://the-cleaners-production.up.railway.app/api/v1

# Request timeout in milliseconds.
API_TIMEOUT_MS=15000

# Display currency used when the backend omits one.
DEFAULT_CURRENCY=NGN
